# .env.example — copy to .env for optional overrides before running docker compose
#
# Usage:
#   cp config.yaml.example config.yaml
#   cp .env.example .env
#   # put your main settings in config.yaml
#   # edit .env only if you want environment overrides / secrets outside config.yaml
#   docker compose run --rm jira-log-exporter
#   docker compose run --rm confluence-log-exporter

# ---------------------------------------------------------------------------
# Jira (optional fallback / override for the jira-log-exporter service)
# ---------------------------------------------------------------------------

JIRA_URL=https://your-org.atlassian.net

# ---------------------------------------------------------------------------
# Confluence (optional fallback / override for the confluence-log-exporter service)
# ---------------------------------------------------------------------------

CONFLUENCE_URL=https://your-org.atlassian.net/wiki

# ---------------------------------------------------------------------------
# Shared Atlassian credentials (optional fallback / override for both services)
# ---------------------------------------------------------------------------

ATLASSIAN_EMAIL=user@example.com
ATLASSIAN_TOKEN=your-atlassian-personal-api-token
