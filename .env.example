# .env.example — copy to .env and fill in your values before running docker compose
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   docker compose up

# ---------------------------------------------------------------------------
# Jira (required for the jira-log-exporter service)
# ---------------------------------------------------------------------------

JIRA_URL=https://your-org.atlassian.net

# ---------------------------------------------------------------------------
# Confluence (required for the confluence-log-exporter service)
# ---------------------------------------------------------------------------

CONFLUENCE_URL=https://your-org.atlassian.net/wiki

# ---------------------------------------------------------------------------
# Shared Atlassian credentials (required for both Jira and Confluence)
# ---------------------------------------------------------------------------

ATLASSIAN_EMAIL=user@example.com
ATLASSIAN_TOKEN=your-atlassian-personal-api-token

# ---------------------------------------------------------------------------
# Graylog GELF output (optional — leave blank to disable)
# ---------------------------------------------------------------------------

GELF_HOST=

# ---------------------------------------------------------------------------
# Fluent Bit HTTP output (optional — leave blank to disable)
# ---------------------------------------------------------------------------

FLUENTBIT_HOST=

# Tag / URL path segment sent to Fluent Bit.
# Defaults to the source name (jira or confluence) when left blank.
FLUENTBIT_TAG=
